{
  "name": "little-focus-island",
  "version": "0.46.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/family-mobile"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:legacy": "node legacy-server.mjs",
    "start": "node apps/api/main.ts",
    "build": "tsc --noEmit && vite build --config vite.studio.config.ts && node scripts/build-web.mjs",
    "voice:generate": "node scripts/generate-voice-assets.mjs",
    "voice:generate:azure": "node scripts/generate-azure-voice-assets.mjs",
    "voice:generate:offline": "node scripts/generate-system-voice-assets.mjs",
    "voice:content": "node scripts/generate-content-voice-assets.mjs",
    "voice:audit": "node scripts/audit-content-voice-assets.mjs",
    "test": "node --test tests/*.test.mjs tests/platform/*.test.ts",
    "test:http": "node --test --test-concurrency=2 tests/http/*.test.mjs",
    "content:audit": "node scripts/audit-content.ts",
    "content:readiness": "node scripts/audit-content-readiness.ts",
    "mobile:start": "npm run start --workspace=@focus/family-mobile",
    "mobile:check": "npm run check --workspace=@focus/family-mobile",
    "mobile:bundle": "npm run bundle --workspace=@focus/family-mobile",
    "mobile:prepare-build": "node scripts/prepare-mobile-build.mjs",
    "check": "tsc --noEmit && node --check src/app.js && node --check src/core.js && node --check legacy-server.mjs",
    "build:vercel": "node scripts/build-vercel-web.mjs",
    "visuals:build": "node scripts/build-visuals.mjs",
    "visuals:check": "node scripts/build-visuals.mjs --check",
    "visuals:proof": "node scripts/proof-visuals.mjs",
    "studio:build": "tsc --noEmit && vite build --config vite.studio.config.ts",
    "db:prepare": "node scripts/prepare-postgres.ts"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "lucide-react": "0.487.0",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.11.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
