{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{apps/api/**,packages/**,src/**,package.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/content-assets/:path*", "destination": "/api/index" },
    { "source": "/media/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
